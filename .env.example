"""
AURA environment configuration example.

Copy this file to .env and fill in your values.
NEVER commit .env to version control.
"""

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aura:aura@postgres:5432/aura

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Object Storage (MinIO / S3) ────────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aura-evidence

# ── Auth ──────────────────────────────────────────────────────────────────────
# IMPORTANT: Change in production! Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SOFTWARE_VERSION=0.1.0
ENVIRONMENT=development
MAX_UPLOAD_SIZE_MB=500

# ── Evidence Signing ──────────────────────────────────────────────────────────
# Generate keys: python -m packages.security.signing generate --output ./secrets/
EVIDENCE_SIGNING_KEY_PATH=/run/secrets/signing.key

# ── Malware Scanning (ClamAV) ─────────────────────────────────────────────────
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://forensics-portal:3000

# ── Inference Workers ─────────────────────────────────────────────────────────
# Model weights directories — populate after acquiring datasets
AUDIO_MODELS_DIR=/models/audio
VIDEO_MODELS_DIR=/models/video
CALIBRATION_DIR=/models/calibration

# Audio inference settings
AUDIO_EXTRACTION_SAMPLE_RATE=16000
TELEPHONY_SAMPLE_RATE=8000
AUDIO_ANALYSIS_WINDOW_S=3.0

# Video inference settings
VIDEO_FRAME_EXTRACTION_FPS=2.0
VIDEO_FACE_MIN_SIZE_PX=64
VIDEO_MIN_FACE_VISIBILITY_PCT=0.4

# ── Fusion ────────────────────────────────────────────────────────────────────
FUSION_AUDIO_WEIGHT=0.4
FUSION_VIDEO_WEIGHT=0.4
FUSION_SYNC_WEIGHT=0.2
FUSION_HIGH_RISK_THRESHOLD=0.80
FUSION_MEDIUM_RISK_THRESHOLD=0.50
FUSION_MIN_CONFIDENCE_FOR_DECISION=0.40
FUSION_TIMEOUT_SECONDS=300

# ── Alerts ────────────────────────────────────────────────────────────────────
ALERT_THROTTLE_WINDOW_SECONDS=30
ALERT_MAX_PER_WINDOW=3
ALERT_WEBHOOK_URL=

# ── Portal ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
